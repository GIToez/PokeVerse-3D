play.pokeverse.quest {
	root * /opt/pokeverse-3d
	encode zstd gzip

	@internal path /server /server/* /tools /tools/* /docs /docs/* /upcoming /upcoming/* /node_modules /node_modules/* /.git /.git/*
	respond @internal 404

	handle /servidor* {
		uri strip_prefix /servidor
		reverse_proxy 127.0.0.1:5190
	}

	redir /admin /admin/ 308
	handle /admin/scenery {
		rewrite * /admin/scenery.html
		file_server
	}
	handle /admin/cenario {
		rewrite * /admin/scenery.html
		file_server
	}
	handle /admin/ {
		rewrite * /admin/index.html
		file_server
	}

	@mjs path *.mjs
	header @mjs Content-Type application/javascript

	# Maps / images / audio: keep a copy, but revalidate every load (304 if unchanged).
	@assets path *.glb *.png *.webp *.jpg *.jpeg *.gif *.ogg *.mp3 *.wav *.ktx2 *.woff *.woff2
	header @assets Cache-Control "public, max-age=0, must-revalidate"
	@code path *.html *.mjs *.js *.css
	header @code Cache-Control "no-cache"

	redir /concepts /concepts/ 308
	handle /concepts/* {
		try_files /public{path} /public{path}/index.html {path} {path}/index.html
		file_server
	}

	handle {
		try_files /public{path} /public{path}/index.html {path} {path}/index.html /index.html
		file_server
	}
}
